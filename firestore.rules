rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ضعي إيميل المعلّمة هنا (بأحرف صغيرة)
    function isAdmin() { return request.auth != null && request.auth.token.email.lower() in ['TEACHER_EMAIL@gmail.com']; }
    function me() { return request.auth.token.email.lower(); }
    function isStudent() { return request.auth != null && exists(/databases/$(db)/documents/students/$(me())); }

    match /sections/{s} {
      allow read: if isAdmin() || isStudent();
      allow write: if isAdmin();
    }
    match /students/{e} {
      allow read: if isAdmin() || (request.auth != null && me() == e);
      allow write: if isAdmin();
    }
    match /progress/{e} {
      allow read: if isAdmin() || (request.auth != null && me() == e);
      allow write: if request.auth != null && me() == e && isStudent();
    }
  }
}
